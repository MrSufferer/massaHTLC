{
  "name": "@hashlocked/massa-htlc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Massa HTLC smart contract for hashlocked-cli",
  "scripts": {
    "build": "massa-as-compile",
    "asbuild:debug": "asc --config asconfig.json --target debug",
    "asbuild:release": "massa-as-compile",
    "test": "asp --summary",
    "test:integration": "jest __tests__/secret-propagation.test.ts"
  },
  "devDependencies": {
    "@as-pect/cli": "^8.1.0",
    "@jest/globals": "^29.7.0",
    "@massalabs/massa-sc-compiler": "^0.2.0",
    "@types/node": "^22.15.29",
    "assemblyscript": "^0.27.30",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0"
  },
  "dependencies": {
    "@massalabs/as-types": "^2.0.0",
    "@massalabs/massa-as-sdk": "^3.0.1-dev",
    "@massalabs/massa-web3": "^5.2.0",
    "as-bignum": "^0.3.1",
    "dotenv": "^16.6.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "testTimeout": 30000,
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
