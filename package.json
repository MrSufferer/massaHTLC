{
  "name": "evm-massa-atomic-swap",
  "version": "1.0.0",
  "description": "Universal EVM ↔ Bitcoin Atomic Swap System",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "massa:deploy": "ts-node massa/scripts/deploy.ts",
    "massa:create": "ts-node massa/scripts/create-htlc.ts",
    "massa:maker:claim": "ts-node massa/scripts/claim-htlc.ts maker-claim",
    "massa:taker:claim": "ts-node massa/scripts/claim-htlc.ts taker-claim",
    "massa:refund": "ts-node massa/scripts/refund-htlc.ts",
    "massa:monitor": "ts-node massa/scripts/monitor-htlc.ts monitor",
    "massa:check-secret": "ts-node massa/scripts/monitor-htlc.ts check-secret",
    "maker:create-massa": "hardhat run evm/scripts/create-order-massa.ts --network sepolia",
    "taker:fill-massa": "hardhat run evm/scripts/fill-order-massa.ts --network sepolia",
    "maker:escrow-massa": "hardhat run evm/scripts/maker-escrow-massa.ts --network sepolia",
    "maker:claim-massa": "hardhat run evm/scripts/maker-claim-massa.ts --network sepolia",
    "taker:claim-eth-massa": "hardhat run evm/scripts/taker-claim-eth-massa.ts --network sepolia",
    "reverse:create-massa": "hardhat run reverse/create-order-reverse-massa.ts --network sepolia",
    "reverse:maker:htlc-massa": "hardhat run reverse/maker-htlc-reverse-massa.ts --network sepolia",
    "reverse:maker:fund-massa": "hardhat run reverse/maker-fund-htlc-reverse-massa.ts --network sepolia",
    "reverse:taker:escrow-massa": "hardhat run reverse/taker-escrow-reverse-massa.ts --network sepolia",
    "reverse:maker:claim-eth-massa": "hardhat run reverse/maker-claim-eth-reverse-massa.ts --network sepolia",
    "reverse:taker:claim-massa": "hardhat run reverse/taker-claim-massa-reverse.ts --network sepolia",
    "deploy:massa-evm": "hardhat run evm/scripts/deploy-massa.ts --network sepolia"
  },
  "keywords": [
    "atomic-swap",
    "bitcoin",
    "ethereum",
    "evm",
    "defi",
    "cross-chain",
    "htlc",
    "trustless"
  ],
  "author": "EVM-Massa Atomic Swap Team",
  "license": "MIT",
  "dependencies": {
    "@1inch/limit-order-protocol": "^2.0.5",
    "@1inch/limit-order-settlement": "^3.1.0",
    "@1inch/solidity-utils": "^6.6.0",
    "@openzeppelin/contracts": "^5.3.0",
    "axios": "^1.6.0",
    "ws": "^8.14.0",
    "@massalabs/massa-web3": "^5.2.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.15.29",
    "concurrently": "^8.2.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.14.3",
    "hardhat": "^2.24.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/btc/test/**/*.test.ts",
      "**/test/integration/**/*.test.ts"
    ],
    "testTimeout": 30000
  }
}
